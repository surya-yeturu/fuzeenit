# Production API URL — set this as a GitHub repository secret named VITE_API_URL
# Example after deploying backend to Render/Railway:
# VITE_API_URL=https://your-api.onrender.com/api

# Base path is set automatically by the GitHub Actions workflow.
# Local Pages preview (optional):
# VITE_BASE_PATH=/fuzen-it/
# GITHUB_PAGES=true
